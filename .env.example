# ==============================================================================
# ENVIRONMENT TEMPLATE (AbdullahAlMaksudAdmin)
# Copy this file to .env.local for local development
# ==============================================================================

# Shared Secrets
RESEND_API_KEY=your_resend_api_key_here
OWNER_EMAIL=your_email@domain.com

# Vercel Blob Storage
AAM_STORE_ID="your_blob_store_id"
BLOB_READ_WRITE_TOKEN="your_blob_read_write_token"
NEXT_PUBLIC_BLOB_BASE_URL=https://your_store_id.public.blob.vercel-storage.com

# Local URLs (Default for Local Development)
NEXT_PUBLIC_SITE_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
BACKEND_API_URL=http://localhost:5000

